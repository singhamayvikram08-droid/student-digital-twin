# ==============================================================================
# STUDENT AI DIGITAL TWIN - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT:
# - Variables starting with NEXT_PUBLIC_ are bundled into client-side JS.
#   NEVER put private API keys, database credentials, or secret tokens here.
# - Private backend API keys (Gemini, OpenRouter, Groq, etc.) must reside
#   exclusively in the ai-service backend environment (ai-service/.env).
# ==============================================================================

# Public Frontend Configuration (Safe for client browsers)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_ENV=development

# Optional Analytics Integration (Only activated with user cookie consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ==============================================================================
# BACKEND SECRETS (SERVER-SIDE ONLY - DO NOT PREFIX WITH NEXT_PUBLIC)
# These are kept strictly on the FastAPI server or private server routes.
# ==============================================================================
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# EXPLABS_API_KEY=your_explabs_api_key_here
